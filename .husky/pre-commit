# dotenvx: refuse the commit if any tracked .env* file holds plaintext
# (unencrypted) values. Layered before gitleaks as a dedicated env-file guard.
npx dotenvx ext precommit

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not installed — run 'brew install gitleaks' (see README)." >&2
  exit 1
fi
gitleaks git --staged --redact --no-banner --config .gitleaks.toml
