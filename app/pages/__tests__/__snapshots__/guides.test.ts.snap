// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Guides page (/guides) > renders without crashing and matches snapshot 1`] = `
"<div data-v-3ab52aa2="" class="content content--wide">
  <div data-v-3ab52aa2="" class="guides-head">
    <div data-v-3ab52aa2="">
      <div data-v-3ab52aa2="" class="label">// 2 guides</div>
      <h1 data-v-3ab52aa2="">Your guides</h1>
      <p data-v-3ab52aa2="">Write up a route, a city, or a trick you always tell people.</p>
    </div><button data-v-3ab52aa2="" class="btn btn--outline"><svg data-v-3ab52aa2="" data-icon="" name="layers" size="15"></svg> new guide </button>
  </div><!-- New guide form -->
  <!--v-if-->
  <!-- List load error -->
  <!--v-if-->
  <!-- Delete error (create/edit errors render inside GuideForm itself) -->
  <!--v-if-->
  <!-- Guides list -->
  <div data-v-3ab52aa2="" class="guide-list">
    <div data-v-3ab52aa2="" class="gcard">
      <div data-v-3ab52aa2="" class="gcard__body">
        <div data-v-3ab52aa2="" class="gcard__name">Tokyo on foot</div>
        <div data-v-3ab52aa2="" class="gcard__meta"><span data-v-3ab52aa2="" class="m"><svg data-v-3ab52aa2="" data-icon="" name="clock" size="12"></svg> 8 min read </span><span data-v-3ab52aa2="" class="m"><svg data-v-3ab52aa2="" data-icon="" name="heart" size="12"></svg> 12</span><span data-v-3ab52aa2="" class="tag tag--ongoing">public</span></div>
      </div>
      <div data-v-3ab52aa2="" class="gcard__acts"><button data-v-3ab52aa2="" class="btn btn--outline btn--sm"> edit </button><button data-v-3ab52aa2="" class="btn btn--outline btn--sm">delete</button></div>
    </div>
    <div data-v-3ab52aa2="" class="gcard">
      <div data-v-3ab52aa2="" class="gcard__body">
        <div data-v-3ab52aa2="" class="gcard__name">Slow coastlines</div>
        <div data-v-3ab52aa2="" class="gcard__meta"><span data-v-3ab52aa2="" class="m"><svg data-v-3ab52aa2="" data-icon="" name="clock" size="12"></svg> 5 min read </span><span data-v-3ab52aa2="" class="m"><svg data-v-3ab52aa2="" data-icon="" name="heart" size="12"></svg> 0</span><span data-v-3ab52aa2="" class="tag tag--past">private</span></div>
      </div>
      <div data-v-3ab52aa2="" class="gcard__acts"><button data-v-3ab52aa2="" class="btn btn--outline btn--sm"> edit </button><button data-v-3ab52aa2="" class="btn btn--outline btn--sm">delete</button></div>
    </div>
  </div>
</div>"
`;
