// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`GuideForm > renders without crashing and matches snapshot 1`] = `
"<section data-v-db1b8848="" class="guide-form" aria-label="New guide">
  <h3 data-v-db1b8848="" class="guide-form__title">New guide</h3>
  <form data-v-db1b8848="" class="guide-form__body"><input data-v-db1b8848="" placeholder="Guide title…" value=""><textarea data-v-db1b8848="" placeholder="What should a fellow traveler know?" value=""></textarea>
    <div data-v-db1b8848="" class="guide-form__row"><label data-v-db1b8848="" class="guide-form__field"><span data-v-db1b8848="" class="guide-form__label">Read time (minutes)</span><input data-v-db1b8848="" type="number" min="1" max="1440" class="guide-form__number" aria-invalid="false">
        <!--v-if-->
      </label><label data-v-db1b8848="" class="guide-form__field"><span data-v-db1b8848="" class="guide-form__label">Visibility</span><select data-v-db1b8848="" class="guide-form__select">
          <option data-v-db1b8848="" value="private">Private</option>
          <option data-v-db1b8848="" value="public">Public</option>
        </select></label></div>
    <div data-v-db1b8848="" class="guide-form__acts"><button data-v-db1b8848="" type="submit" class="btn btn--primary btn--sm" disabled=""><svg data-v-db1b8848="" data-icon="" name="check" size="14"></svg> publish guide</button><button data-v-db1b8848="" type="button" class="btn btn--outline btn--sm"> cancel </button></div>
    <!--v-if-->
  </form>
</section>"
`;
